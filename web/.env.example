# Copia a .env.local (no se sube al repositorio)
SUPABASE_URL=https://ltddtuycbonkgwaxsfgm.supabase.co
# Clave pública (sb_publishable_…): sesión de los usuarios (registro, login). Supabase > Project Settings > API Keys
SUPABASE_PUBLISHABLE_KEY=sb_publishable_KFQ1BOpFT0Ln_Fwi_2J4CA_tMlf442Z
# Clave secreta (service_role). Solo se usa en el servidor, nunca llega al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app, para los enlaces de los emails y la vuelta de Google/Stripe (en local, http://localhost:3000)
SITE_URL=http://localhost:3000
# 1 cuando el proveedor Google esté configurado en Supabase (Authentication > Providers > Google)
GOOGLE_AUTH_ENABLED=

# Stripe (modo test: sk_test_… y el secreto del webhook whsec_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Opcional: token de GitHub con permiso "Actions: write" sobre jaumegodia/compete para lanzar capturas desde el panel
GITHUB_TOKEN=
GITHUB_REPO=jaumegodia/compete
